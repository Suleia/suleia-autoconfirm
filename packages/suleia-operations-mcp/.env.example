NODE_ENV=development
PORT=3100
MCP_DATA_MODE=fixture
MCP_AUTH_MODE=bearer
MCP_STAGING_BEARER_TOKEN=replace-with-at-least-32-random-characters
MCP_GRANTED_SCOPES=orders:read,orders:simulate
MCP_ALLOWED_ORIGINS=
MCP_RATE_LIMIT_PER_MINUTE=60
MCP_AUDIT_MODE=stderr
MCP_AUDIT_LOG_PATH=

# These values belong only in Render staging, never in source control.
SUPABASE_STAGING_URL=
SUPABASE_STAGING_READER_TOKEN=
SUPABASE_STAGING_SCHEMA=mcp_read
SUPABASE_STAGING_PROJECT_REF=
EXPECTED_STAGING_PROJECT_REF=

# Hard safety invariants. The process refuses to boot if any are relaxed.
READ_ONLY=true
SIMULATION_ONLY=true
PRODUCTION_WRITES_ENABLED=false
ACTION_EXECUTOR_ENABLED=false
MCP_WRITE_TOOLS_ENABLED=false
