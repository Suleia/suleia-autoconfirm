#quantity-breaks-{{ section.id }}{color:#102e4b}
#quantity-breaks-{{ section.id }} .quantity-breaks__title{margin:0!important;font-size:clamp(17px,2vw,21px)!important;font-weight:850!important;letter-spacing:.025em!important;color:#126d9c!important;line-height:1.2!important}
#quantity-breaks-{{ section.id }} .cg-pack-subtitle{text-align:center;margin:4px 0 16px;color:#627c8b;font-size:10px;font-weight:650;letter-spacing:.07em;line-height:1.25}
#quantity-breaks-{{ section.id }} .quantity-breaks-container{display:grid!important;gap:18px!important}
#quantity-breaks-{{ section.id }} label.quantity-break{position:relative!important;min-height:0!important;height:auto!important;box-sizing:border-box!important;margin:0!important;padding:15px 14px!important;border:1.5px solid #c5e3f2!important;border-radius:16px!important;background:#f7fbff!important;box-shadow:0 4px 14px rgba(16,46,75,.045)!important}
#quantity-breaks-{{ section.id }} label.quantity-break[data-quantity='2']{border:2px solid #168bc5!important;background:linear-gradient(110deg,#fff,#f2faff)!important}
#quantity-breaks-{{ section.id }} label.quantity-break[data-quantity='3']{border:2px solid #268a70!important;background:linear-gradient(110deg,#fff,#f1fbf6)!important}
#quantity-breaks-{{ section.id }} input[type='radio']:checked+label.quantity-break{box-shadow:0 0 0 1px #168bc5,0 5px 16px rgba(18,109,156,.1)!important}
#quantity-breaks-{{ section.id }} input[type='radio']:checked+label.quantity-break[data-quantity='3']{box-shadow:0 0 0 1px #268a70,0 5px 16px rgba(38,138,112,.1)!important}
#quantity-breaks-{{ section.id }} input[type='radio']:focus-visible+label.quantity-break{outline:3px solid #126d9c!important;outline-offset:4px!important}
#quantity-breaks-{{ section.id }} label.quantity-break:before{top:10px!important;left:10px!important;width:16px!important;height:16px!important;border:1.5px solid #9db8c8!important;background:#fff!important;box-sizing:border-box!important}
#quantity-breaks-{{ section.id }} input:checked+label.quantity-break:before{border:5px solid #168bc5!important;background:#fff!important}
#quantity-breaks-{{ section.id }} input:checked+label.quantity-break[data-quantity='3']:before{border-color:#268a70!important}
#quantity-breaks-{{ section.id }} label.quantity-break .quantity-break__image-and-content{display:flex!important;align-items:center!important;gap:12px!important;width:100%!important;min-width:0!important}
#quantity-breaks-{{ section.id }} .cg-pack-photo{width:132px!important;min-width:132px!important;flex:0 0 132px!important;height:146px!important;background:transparent!important;box-shadow:none!important}
#quantity-breaks-{{ section.id }} .cg-pack-photo img{display:block!important;width:100%!important;height:100%!important;object-fit:contain!important;background:transparent!important;border-radius:0!important;box-shadow:none!important}
#quantity-breaks-{{ section.id }} .quantity-break__content{display:grid!important;grid-template-columns:minmax(0,1fr) max-content!important;gap:10px!important;flex:1!important;min-width:0!important;align-items:center!important}
#quantity-breaks-{{ section.id }} .quantity-break__left{display:flex!important;flex-direction:column!important;gap:7px!important;min-width:0!important}
#quantity-breaks-{{ section.id }} .quantity-break__label{display:flex!important;flex-direction:column!important;align-items:flex-start!important;gap:4px!important;min-width:0!important}
#quantity-breaks-{{ section.id }} .quantity-break__label-text{font-size:22px!important;font-weight:850!important;color:#102e4b!important;line-height:1.15!important}
#quantity-breaks-{{ section.id }} .quantity-break__benefit{display:block!important;width:auto!important;max-width:100%!important;padding:0!important;border:0!important;border-radius:0!important;background:none!important;color:#597486!important;font-size:12px!important;font-weight:500!important;line-height:1.3!important;white-space:normal!important;overflow-wrap:normal!important}
#quantity-breaks-{{ section.id }} .quantity-break__caption{display:none!important}
#quantity-breaks-{{ section.id }} :is(.quantity-break__label-text,.quantity-break__benefit,.cg-duration,.cg-saving){letter-spacing:0!important}
#quantity-breaks-{{ section.id }} .cg-duration{order:2;display:flex;align-items:center;gap:7px;width:fit-content;max-width:100%;box-sizing:border-box;padding:7px 9px;border:1px solid #d5eaf6;border-radius:9px;background:#eaf6ff;color:#176b98;line-height:1.15}
#quantity-breaks-{{ section.id }} .cg-duration svg{display:block;flex:0 0 21px;width:21px;height:21px}
#quantity-breaks-{{ section.id }} .cg-duration-copy{display:flex;flex-direction:column;min-width:0}
#quantity-breaks-{{ section.id }} .cg-duration-copy>span{font-size:10px;font-weight:500;line-height:1.15}
#quantity-breaks-{{ section.id }} .cg-duration strong{font-size:17px;font-weight:850;line-height:1.15;white-space:nowrap}
#quantity-breaks-{{ section.id }} label[data-quantity='3'] .cg-duration{background:#e6f6ef;border-color:#cce9dc;color:#1d745d}
#quantity-breaks-{{ section.id }} .quantity-break__right{display:flex!important;flex:initial!important;flex-direction:column!important;align-items:flex-end!important;gap:5px!important;min-width:0!important;text-align:right!important}
#quantity-breaks-{{ section.id }} .quantity-break__price{order:0!important;font-size:30px!important;font-weight:900!important;line-height:1.1!important;white-space:nowrap!important;color:#102e4b!important}
#quantity-breaks-{{ section.id }} .quantity-break__compare-price{order:1!important;font-size:13px!important;line-height:1.2!important;text-decoration:line-through!important;color:#7e909e!important;white-space:nowrap!important}
#quantity-breaks-{{ section.id }} .cg-saving{order:2!important;display:inline-block!important;padding:5px 7px!important;border-radius:7px!important;background:#ffe7ed!important;color:#a82c4f!important;font-size:11px!important;font-weight:800!important;line-height:1.2!important;white-space:nowrap!important}
#quantity-breaks-{{ section.id }} .quantity-break__badge{position:absolute!important;top:0!important;left:auto!important;right:10px!important;bottom:auto!important;transform:translateY(-50%)!important;width:auto!important;max-width:calc(100% - 48px)!important;margin:0!important;padding:5px 10px!important;border:0!important;border-radius:20px!important;background:#168bc5!important;color:#fff!important;font-size:10px!important;font-weight:800!important;letter-spacing:.015em!important;line-height:1.2!important;text-align:center!important;white-space:nowrap!important}
#quantity-breaks-{{ section.id }} label[data-quantity='3'] .quantity-break__badge{background:#268a70!important;color:#fff!important;opacity:1!important}
#quantity-breaks-{{ section.id }} .cg-duration-note{margin:9px 1px 0;color:#647a87;font-size:10px;line-height:1.4;font-style:italic;text-align:left}
@media(max-width:749px){
 #quantity-breaks-{{ section.id }} .quantity-breaks__title{font-size:17px!important}
 #quantity-breaks-{{ section.id }} .cg-pack-subtitle{margin:4px 0 10px;font-size:9px}
 #quantity-breaks-{{ section.id }} .quantity-breaks-container{gap:14px!important}
 #quantity-breaks-{{ section.id }} label.quantity-break{padding:7px 8px!important;border-radius:13px!important}
 #quantity-breaks-{{ section.id }} label.quantity-break .quantity-break__image-and-content{gap:7px!important}
 #quantity-breaks-{{ section.id }} .cg-pack-photo{width:85px!important;min-width:85px!important;flex-basis:85px!important;height:110px!important}
 #quantity-breaks-{{ section.id }} .quantity-break__content{gap:7px!important}
 #quantity-breaks-{{ section.id }} .quantity-break__left{gap:5px!important}
 #quantity-breaks-{{ section.id }} .quantity-break__label{gap:3px!important}
 #quantity-breaks-{{ section.id }} .quantity-break__label-text{font-size:18px!important}
 #quantity-breaks-{{ section.id }} .quantity-break__benefit{font-size:10.5px!important}
 #quantity-breaks-{{ section.id }} .cg-duration{gap:5px;padding:5px 6px;border-radius:7px}
 #quantity-breaks-{{ section.id }} .cg-duration svg{flex-basis:17px;width:17px;height:17px}
 #quantity-breaks-{{ section.id }} .cg-duration-copy>span{font-size:9px}
 #quantity-breaks-{{ section.id }} .cg-duration strong{font-size:15px}
 #quantity-breaks-{{ section.id }} .quantity-break__right{gap:4px!important}
 #quantity-breaks-{{ section.id }} .quantity-break__price{font-size:23px!important}
 #quantity-breaks-{{ section.id }} .quantity-break__compare-price{font-size:11px!important}
 #quantity-breaks-{{ section.id }} .cg-saving{padding:4px 5px!important;font-size:10px!important}
 #quantity-breaks-{{ section.id }} .quantity-break__badge{right:9px!important;padding:4px 8px!important;font-size:9px!important}
 #quantity-breaks-{{ section.id }} .cg-duration-note{font-size:9px;line-height:1.35;margin-top:8px}
}
@media(max-width:390px){
 #quantity-breaks-{{ section.id }} label.quantity-break{padding:6px 7px!important}
 #quantity-breaks-{{ section.id }} label.quantity-break .quantity-break__image-and-content{gap:6px!important}
 #quantity-breaks-{{ section.id }} .cg-pack-photo{width:65px!important;min-width:65px!important;flex-basis:65px!important;height:96px!important}
 #quantity-breaks-{{ section.id }} .quantity-break__content{gap:6px!important}
 #quantity-breaks-{{ section.id }} .quantity-break__label-text{font-size:17px!important}
 #quantity-breaks-{{ section.id }} .quantity-break__price{font-size:20px!important}
 #quantity-breaks-{{ section.id }} .cg-saving{font-size:9px!important}
 #quantity-breaks-{{ section.id }} .cg-duration{gap:4px;padding:5px}
 #quantity-breaks-{{ section.id }} .cg-duration svg{flex-basis:15px;width:15px;height:15px}
 #quantity-breaks-{{ section.id }} .cg-duration strong{font-size:14px}
}
@media(max-width:340px){
 #quantity-breaks-{{ section.id }} .quantity-break__label-text{font-size:15px!important}
 #quantity-breaks-{{ section.id }} .quantity-break__benefit{font-size:10px!important}
 #quantity-breaks-{{ section.id }} .cg-duration{gap:3px;padding:4px}
 #quantity-breaks-{{ section.id }} .cg-duration strong{font-size:13px}
 #quantity-breaks-{{ section.id }} .quantity-break__badge{font-size:8.5px!important;padding:4px 7px!important}
}
