esaltado elegante y sutil para el stock *\/\n  .nida-stock-important {\n    color: #76101a !important; \/* Rojo e-commerce refinado *\/\n    font-weight: 700 !important;\n    background: rgba(118, 16, 26, 0.05);\n    padding: 1px 5px;\n    border-radius: 3px;\n    display: inline-block;\n  }\n\n  \/* Indicador de estado \"Live\" minimalista *\/\n  .nida-dot {\n    display: inline-block;\n    width: 7px;\n    height: 7px;\n    background: #76101a; \/* Azul tecnológico *\/\n    border-radius: 50%;\n    margin-right: 8px;\n    vertical-align: middle;\n    position: relative;\n  }\n\n  \/* Animación de pulso continuo de alta precisión *\/\n  .nida-dot::after {\n    content: '';\n    position: absolute;\n    top: 0;\n    left: 0;\n    width: 100%;\n    height: 100%;\n    border-radius: 50%;\n    background: #76101a;\n    animation: nidaPulse 2.5s cubic-bezier(0.16, 1, 0.3, 1) infinite;\n  }\n\n  .nida-icon {\n    margin-right: 4px;\n    vertical-align: middle;\n    display: inline-block;\n    font-size: 13px;\n  }\n\n  @keyframes nidaPulse {\n    0% { transform: scale(1); opacity: 0.5; }\n    100% { transform: scale(3); opacity: 0; }\n  }\n\n  @media (max-width: 480px) {\n    .nida-stock-alert {\n      padding: 9px 12px;\n    }\n    .nida-stock-text {\n      font-size: 13px;\n    }\n  }\n<\/style>\n\n<script>\n  document.addEventListener(\"DOMContentLoaded\", function () {\n    const stockElement = document.getElementById(\"nida-stock-count\");\n    if (!stockElement) return;\n\n    const minStock = 10;\n    const maxStock = 20;\n\n    \/\/ Valor inicial de partida\n    let currentStock = 18;\n    stockElement.textContent = currentStock;\n\n    let ascending = false;\n\n    \/\/ Actualización garantizada y fija cada 10 segundos (10000 ms)\n    setInterval(function () {\n      if (ascending) {\n        \/\/ Incremento fijo para asegurar cambio visual inmediato\n        currentStock += 2; \n        if (currentStock >= maxStock) {\n          currentStock = maxStock;\n      