<section class="seoul-ingredients" aria-labelledby="SeoulIngredients-{{ section.id }}">
  <div class="seoul-ingredients__intro">
    <p class="seoul-eyebrow">{{ section.settings.eyebrow | escape }}</p>
    <h2 id="SeoulIngredients-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
    <p>{{ section.settings.description | escape }}</p>
  </div>
  <div class="seoul-ingredients__grid">
    {% for block in section.blocks %}
      <article class="seoul-ingredient{% if forloop.first %} seoul-ingredient--featured{% endif %}" {{ block.shopify_attributes }}>
        <span class="seoul-ingredient__number" aria-hidden="true">{% if forloop.index < 10 %}0{% endif %}{{ forloop.index }}</span>
        <h3>{{ block.settings.title | escape }}</h3>
        {% if block.settings.description != blank %}<p>{{ block.settings.description | escape }}</p>{% endif %}
      </article>
    {% endfor %}
  </div>
  <p class="seoul-ingredients__note">{{ section.settings.note | escape }}</p>
</section>
{% schema %}
{
  "name": "SEOUL · Ingredientes",
  "tag": "section",
  "class": "section",
  "max_blocks": 12,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "K-BEAUTY · FÓRMULA" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Una fórmula pensada para tu mirada" },
    { "type": "textarea", "id": "description", "label": "Introducción" },
    { "type": "textarea", "id": "note", "label": "Nota de fórmula" }
  ],
  "blocks": [
    { "type": "ingredient", "name": "Ingrediente", "settings": [
      { "type": "text", "id": "title", "label": "Nombre", "default": "Ingrediente" },
      { "type": "textarea", "id": "description", "label": "Descripción" }
    ] }
  ],
  "presets": [{ "name": "SEOUL · Ingredientes" }]
}
{% endschema %}
