 nidaPulse 2.5s cubic-bezier(0.16, 1, 0.3, 1) infinite;\n  }\n\n  .nida-icon {\n    margin-right: 4px;\n    vertical-align: middle;\n    display: inline-block;\n    font-size: 13px;\n  }\n\n  @keyframes nidaPulse {\n    0% { transform: scale(1); opacity: 0.5; }\n    100% { transform: scale(3); opacity: 0; }\n  }\n\n  @media (max-width: 480px) {\n    .nida-stock-alert {\n      padding: 9px 12px;\n    }\n    .nida-stock-text {\n      font-size: 13px;\n    }\n  }\n</style>\n\n<script>\n  document.addEventListener(\"DOMContentLoaded\", function () {\n    const stockElement = document.getElementById(\"nida-stock-count\");\n    if (!stockElement) return;\n\n    const minStock = 10;\n    const maxStock = 20;\n\n    // Valor inicial de partida\n    let currentStock = 18;\n    stockElement.textContent = currentStock;\n\n    let ascending = false;\n\n    // Actualización garantizada y fija cada 10 segundos (10000 ms)\n    setInterval(function () {\n      if (ascending) {\n        // Incremento fijo para asegurar cambio visual inmediato\n        currentStock += 2; \n        if (currentStock >= maxStock) {\n          currentStock = maxStock;\n          ascending = false;\n        }\n      } else {\n        // Decremento fijo para asegurar cambio visual inmediato\n        currentStock -= 2;\n        if (currentStock <= minStock) {\n          currentStock = minStock;\n          ascending = true;\n        }\n      }\n\n      // Se fuerza la actualización en el HTML sin falta\n      stockElement.textContent = currentStock;\n    }, 10000);\n  });\n</script>"
