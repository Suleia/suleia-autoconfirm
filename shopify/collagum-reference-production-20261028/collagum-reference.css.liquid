#quantity-breaks-{{ section.id }}{container-type:inline-size;color:#0b2455;--cg-photo-width:clamp(78px,31cqw,160px);--cg-price-width:clamp(68px,24cqw,112px)}
#quantity-breaks-{{ section.id }} .quantity-breaks__title{margin:0!important;color:#082456!important;font-size:clamp(16px,5.7cqw,24px)!important;font-weight:900!important;line-height:1.15!important;letter-spacing:-.035em!important;gap:8px!important}
