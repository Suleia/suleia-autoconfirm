#quantity-breaks-{{ section.id }} label[data-quantity='3'] .cg-duration{background:#dcf8e8;color:#009e4f}
#quantity-breaks-{{ section.id }} label[data-quantity='3'] .cg-duration strong{color:#008e42}
#quantity-breaks-{{ section.id }} label[data-quantity='3'] .cg-duration-spark{color:#00a558}
#quantity-breaks-{{ section.id }} .quantity-break__right{grid-column:3;grid-row:1 / span 2;display:flex!important;flex:initial!important;flex-direction:column!important;align-self:start!important;align-items:flex-end!important;gap:5px!important;min-width:0!important;margin:1px 0 0!important;text-align:right!important}
#quantity-breaks-{{ section.id }} .cg-saving{order:0!important;display:inline-block!important;margin:0!important;padding:6px 7px!important;border-radius:6px!important;background:#ffe2eb!important;color:#f02d62!important;font-size:clamp(8px,2.7cqw,11px)!important;line-height:1.1!important;font-weight:800!important;letter-spacing:-.025em!important;white-space:nowrap!important}
#quantity-breaks-{{ section.id }} .quantity-break__price{order:1!important;color:#082456!important;font-size:clamp(20px,7.15cqw,32px)!important;line-height:1.03!important;font-weight:900!important;letter-spacing:-.055em!important;white-space:nowrap!important}
#quantity-breaks-{{ section.id }} .quantity-break__compare-price{order:2!important;color:#8d9aac!important;font-size:clamp(10px,3.2cqw,14px)!important;line-height:1.05!important;letter-spacing:-.02em!important;text-decoration:line-through!important;white-space:nowrap!important}
#quantity-breaks-{{ section.id }} .quantity-break__badge{position:absolute!important;top:0!important;right:6px!important;left:auto!important;bottom:auto!important;transform:translateY(-57%)!important;display:inline-flex!important;align-items:center!important;gap:5px!important;box-sizing:border-box!important;width:auto!important;max-width:calc(100% - 32px)!important;margin:0!important;padding:5px 10px!important;border:0!important;border-radius:999px!important;background:linear-gradient(#008fe1,#0063ba)!important;color:#fff!important;box-shadow:0 2px 4px rgba(0,101,180,.18)!important;opacity:1!important;font-size:clamp(8px,2.5cqw,11px)!important;font-weight:800!important;line-height:1.1!important;letter-spacing:0!important;white-space:nowrap!important}
