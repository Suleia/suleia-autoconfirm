#quantity-breaks-{{ section.id }} label[data-quantity='3'] .quantity-break__badge{background:linear-gradient(#16b56e,#07924e)!important;box-shadow:0 2px 4px rgba(9,145,76,.16)!important}
#quantity-breaks-{{ section.id }} .cg-pack-callout{grid-column:2 / 4;grid-row:3;display:flex;align-items:center;justify-content:flex-end;gap:4px;min-width:0;margin:0;color:#0081d0;line-height:1.1;letter-spacing:0}
