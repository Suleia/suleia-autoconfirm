#quantity-breaks-{{ section.id }} .cg-pack-photo{grid-column:1;grid-row:1 / span 3;align-self:center;position:relative!important;width:var(--cg-photo-width)!important;min-width:0!important;height:auto!important;aspect-ratio:276 / 306!important;overflow:hidden!important;margin:0!important;padding:0!important;flex:initial!important;background:transparent!important;box-shadow:none!important;border-radius:0!important}
#quantity-breaks-{{ section.id }} .cg-pack-photo img{position:absolute!important;display:block!important;max-width:none!important;min-width:0!important;width:231.884058%!important;height:143.79085%!important;left:-65.217391%!important;top:-5.228758%!important;object-fit:fill!important;object-position:center!important;margin:0!important;padding:0!important;transform:none!important;box-shadow:none!important;border-radius:0!important;background:transparent!important}
#quantity-breaks-{{ section.id }} label[data-quantity='2'] .cg-pack-photo{aspect-ratio:439 / 317!important}
#quantity-breaks-{{ section.id }} label[data-quantity='2'] .cg-pack-photo img{width:145.785877%!important;height:138.801262%!important;left:-22.551253%!important;top:-5.047319%!important}
#quantity-breaks-{{ section.id }} label[data-quantity='3'] .cg-pack-photo{aspect-ratio:522 / 317!important}
#quantity-breaks-{{ section.id }} label[data-quantity='3'] .cg-pack-photo img{width:122.605364%!important;height:138.801262%!important;left:-9.578544%!important;top:-1.26183%!important}
#quantity-breaks-{{ section.id }} .quantity-break__label{grid-column:2;grid-row:1;display:flex!important;flex-direction:column!important;align-items:flex-start!important;gap:3px!important;min-width:0!important}
#quantity-breaks-{{ section.id }} .quantity-break__label-text{color:#082456!important;font-size:clamp(16px,6cqw,25px)!important;line-height:1.05!important;font-weight:900!important;letter-spacing:-.035em!important;word-spacing:.04em!important;white-space:nowrap!important}
#quantity-breaks-{{ section.id }} .quantity-break__benefit{display:block!important;max-width:100%!important;width:auto!important;margin:0!important;padding:0!important;border:0!important;border-radius:0!important;background:none!important;color:#6a85a7!important;font-size:clamp(10px,3cqw,13px)!important;font-weight:500!important;line-height:1.12!important;letter-spacing:0!important;white-space:normal!important}
