#quantity-breaks-{{ section.id }} .quantity-breaks-container{display:grid!important;gap:18px!important}
#quantity-breaks-{{ section.id }} label.quantity-break{position:relative!important;margin:0!important;min-height:0!important;height:auto!important;box-sizing:border-box!important;padding:12px 9px 10px 24px!important;border:1px solid #bfE7ff!important;border-radius:12px!important;background:linear-gradient(110deg,#fff 40%,#f7fcff)!important;box-shadow:0 4px 12px rgba(23,127,184,.06)!important}
