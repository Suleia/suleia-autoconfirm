#quantity-breaks-{{ section.id }} label[data-quantity='3']{border:1.5px solid #42c782!important;background:linear-gradient(110deg,#fff 25%,#f2fff7 75%,#e3faeb)!important;box-shadow:0 4px 12px rgba(40,171,100,.08)!important}
#quantity-breaks-{{ section.id }} input:checked+label.quantity-break{box-shadow:0 0 0 1px #15b5ed,0 5px 16px rgba(14,151,220,.15)!important}
#quantity-breaks-{{ section.id }} input:checked+label[data-quantity='3']{box-shadow:0 0 0 1px #34bf79,0 5px 16px rgba(40,171,100,.12)!important}
#quantity-breaks-{{ section.id }} input:focus-visible+label.quantity-break{outline:3px solid #0753a8!important;outline-offset:4px!important}
