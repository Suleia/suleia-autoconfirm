#quantity-breaks-{{ section.id }} label[data-quantity='3'] .cg-pack-callout>span{background:#d9f5e3;color:#008947}
#quantity-breaks-{{ section.id }} .cg-duration-note{margin:8px 1px 0;color:#60748b;font-size:9px;font-style:italic;font-weight:400;line-height:1.3;letter-spacing:0}
@media(max-width:749px){#quantity-breaks-{{ section.id }}{width:calc(100% + 20px);margin-inline:-10px}}
