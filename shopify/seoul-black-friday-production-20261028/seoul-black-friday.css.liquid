/* SEOUL only. Original inputs, dynamic prices and cart behavior are retained. */
#quantity-breaks-{{ section.id }}.s88-black-friday{container-type:inline-size;color:#2B1D1A;max-width:620px;margin-inline:auto}
#quantity-breaks-{{ section.id }}.s88-black-friday .quantity-breaks__title{margin:0 0 18px!important;gap:10px!important;color:#7A1020!important;line-height:.95!important;font-family:Georgia,'Times New Roman',serif!important;font-size:clamp(25px,8.3cqw,44px)!important;font-weight:700!important;letter-spacing:-.025em!important}
#quantity-breaks-{{ section.id }}.s88-black-friday .quantity-breaks__title>span:first-child,#quantity-breaks-{{ section.id }}.s88-black-friday .quantity-breaks__title>span:last-child{height:1px!important;background:#b77a7d!important;flex:1}
#quantity-breaks-{{ section.id }} .s88-offer{display:block!important;height:auto!important;background:none!important;font:600 clamp(9px,2.7cqw,14px)/1.4 Georgia,serif!important;letter-spacing:.55em!important;padding-left:.55em;margin-bottom:2px}
#quantity-breaks-{{ section.id }}.s88-black-friday .quantity-breaks-container{display:grid!important;gap:17px!important}
#quantity-breaks-{{ section.id }}.s88-black-friday label.quantity-break{display:grid!important;grid-template-columns:15px minmax(0,1fr)!important;align-items:center!important;gap:5px!important;position:relative;min-width:0;min-height:144px!important;padding:12px 8px!important;margin:0!important;border:1.5px solid #E6D8C9!important;border-radius:15px!important;background:#FFFDF9!important;box-shadow:0 5px 16px #7a10200b!important;overflow:visible!important;color:#2B1D1A!important}
#quantity-breaks-{{ section.id }}.s88-black-friday label.quantity-break::before{position:static!important;display:block!important;width:15px!important;height:15px!important;margin:0!important;border:1.5px solid #c8ae98!important;box-shadow:none!important;transform:none!important;grid-column:1;grid-row:1;align-self:center;background:transparent!important}
#quantity-breaks-{{ section.id }}.s88-black-friday input:checked+label.quantity-break::before{border-color:#8F1022!important;background:#8F1022!important;box-shadow:inset 0 0 0 2px #fff!important}
#quantity-breaks-{{ section.id }}.s88-black-friday input:focus-visible+label.quantity-break{outline:3px solid #7A1020;outline-offset:4px}
#quantity-breaks-{{ section.id }}.s88-black-friday label[data-quantity='2']{border:2px solid #8F1022!important;background:linear-gradient(110deg,#FFFDF9,#FFF3F5)!important;box-shadow:0 7px 20px #7a102019!important}
#quantity-breaks-{{ section.id }}.s88-black-friday label[data-quantity='3']{border:1.8px solid #C18B2F!important;background:#FFF9F1!important}
#quantity-breaks-{{ section.id }}.s88-black-friday input:checked+label{box-shadow:0 0 0 1px #8F1022,0 8px 22px #7a10201c!important}
#quantity-breaks-{{ section.id }}.s88-black-friday .quantity-break__image-and-content{grid-column:2;grid-row:1;display:grid!important;grid-template-columns:clamp(75px,25cqw,145px) minmax(0,1fr) clamp(78px,25cqw,137px)!important;gap:5px!important;align-items:center!important;width:100%!important;min-width:0!important}
#quantity-breaks-{{ section.id }}.s88-black-friday .quantity-break__content{display:contents!important}
#quantity-breaks-{{ section.id }} .s88-pack-photo{grid-column:1;position:relative!important;width:100%!important;min-width:0!important;height:clamp(120px,39cqw,182px)!important;overflow:hidden!important;background:transparent!important;isolation:isolate}
#quantity-breaks-{{ section.id }} .s88-pack-photo img{display:block!important;position:absolute!important;object-fit:contain!important;object-position:center!important;border:0!important;border-radius:0!important;max-width:none!important;max-height:118%!important;margin:0!important;box-shadow:none!important;background:transparent!important;mix-blend-mode:multiply}
#quantity-breaks-{{ section.id }} label[data-quantity='1'] .s88-pack-photo img{inset:0!important;width:100%!important;height:100%!important}
/* Trim only unused white canvas in CSS; all three tubes remain inside the window. */
#quantity-breaks-{{ section.id }} label[data-quantity='2'] .s88-pack-photo img{width:190%!important;height:auto!important;aspect-ratio:1;left:-45%!important;top:50%!important;transform:translateY(-50%)}
#quantity-breaks-{{ section.id }} label[data-quantity='3'] .s88-pack-photo img{width:150%!important;height:auto!important;aspect-ratio:1;left:-25%!important;top:50%!important;transform:translateY(-50%)}
#quantity-breaks-{{ section.id }}.s88-black-friday .quantity-break__left{grid-column:2;display:flex!important;flex-direction:column!important;min-width:0!important;gap:7px!important;text-align:left!important}
#quantity-breaks-{{ section.id }}.s88-black-friday .quantity-break__label{display:contents!important}
#quantity-breaks-{{ section.id }}.s88-black-friday .quantity-break__label-text{order:0;display:block!important;color:#2B1D1A!important;font:700 clamp(20px,7cqw,33px)/1.02 Georgia,'Times New Roman',serif!important;letter-spacing:-.035em!important;white-space:nowrap!important}
#quantity-breaks-{{ section.id }} .s88-duration{order:1;display:flex;align-items:center;box-sizing:border-box;min-width:0;max-width:100%;width:100%;gap:4px;background:#7a102008;border-radius:10px;padding:6px 4px;color:#7A1020;font:600 clamp(9.5px,3.2cqw,15px)/1.17 Arial,sans-serif}
#quantity-breaks-{{ section.id }} .s88-calendar{flex:0 0 16px;width:16px;height:22px;stroke:currentColor}
#quantity-breaks-{{ section.id }} .s88-duration-copy{display:block!important;min-width:0;font:inherit!important}
#quantity-breaks-{{ section.id }} .s88-duration-copy>span{display:block!important;white-space:nowrap!important;font:inherit!important;letter-spacing:0!important}
#quantity-breaks-{{ section.id }} label[data-quantity='3'] .s88-duration{color:#95631f;background:#c18b2f12}
#quantity-breaks-{{ section.id }}.s88-black-friday .quantity-break__benefit{order:2;display:block!important;max-width:100%!important;padding:0!important;margin:0!important;border:0!important;border-radius:0!important;background:none!important;color:#776B66!important;white-space:normal!important;text-transform:none!important;font:400 clamp(10px,3.25cqw,14px)/1.25 Arial,sans-serif!important;letter-spacing:0!important}
#quantity-breaks-{{ section.id }}.s88-black-friday .quantity-break__caption{display:none!important}
#quantity-breaks-{{ section.id }}.s88-black-friday .quantity-break__right{grid-column:3;min-width:0!important;width:auto!important;display:flex!important;flex-direction:column!important;align-items:flex-end!important;gap:5px!important;text-align:right!important}
#quantity-breaks-{{ section.id }}.s88-black-friday .s88-saving{order:0;display:inline-block!important;white-space:nowrap!important;padding:5px 6px!important;background:#ffdde5!important;color:#c21c49!important;border-radius:7px!important;font:700 clamp(8px,2.85cqw,12px)/1.1 Arial,sans-serif!important}
#quantity-breaks-{{ section.id }}.s88-black-friday .quantity-break__price{order:1;display:block!important;color:#4b0713!important;font:700 clamp(25px,8.8cqw,45px)/1 Georgia,'Times New Roman',serif!important;letter-spacing:-.05em!important;white-space:nowrap!important}
#quantity-breaks-{{ section.id }}.s88-black-friday .quantity-break__compare-price{order:2;color:#9f9690!important;font:500 clamp(11px,3.65cqw,17px)/1.1 Arial,sans-serif!important;text-decoration:line-through!important}
#quantity-breaks-{{ section.id }}.s88-black-friday .quantity-break__badge{position:absolute!important;inset:-11px 9px auto auto!important;display:flex!important;align-items:center!important;gap:5px!important;transform:none!important;width:auto!important;max-width:calc(100% - 20px)!important;margin:0!important;border:0!important;border-radius:20px!important;padding:5px 10px!important;font:700 clamp(8px,2.7cqw,12px)/1 Arial,sans-serif!important;letter-spacing:.025em!important;white-space:nowrap!important;background:#7A1020!important;color:#fff!important;box-shadow:0 3px 8px #7a102015!important}
#quantity-breaks-{{ section.id }}.s88-black-friday .quantity-break__badge::before,#quantity-breaks-{{ section.id }}.s88-black-friday .quantity-break__badge::after{display:none!important}
#quantity-breaks-{{ section.id }}.s88-black-friday label[data-quantity='1'] .quantity-break__badge{background:#f3e9df!important;color:#7A1020!important}
#quantity-breaks-{{ section.id }}.s88-black-friday label[data-quantity='3'] .quantity-break__badge{background:#a57730!important;color:#fff!important}
#quantity-breaks-{{ section.id }} .s88-badge-icon{width:12px;height:12px;flex:none}
#quantity-breaks-{{ section.id }}.s88-black-friday .quantity-break__badge{opacity:1!important}
@media(max-width:749px){#quantity-breaks-{{ section.id }}.s88-black-friday{width:calc(100% + 20px)!important;max-width:none;margin-left:-10px!important;margin-right:-10px!important}}
@container(max-width:300px){#quantity-breaks-{{ section.id }}.s88-black-friday .quantity-break__image-and-content{grid-template-columns:61px minmax(0,1fr) 73px!important;gap:3px!important}#quantity-breaks-{{ section.id }}.s88-black-friday .quantity-break__label-text{font-size:18px!important}#quantity-breaks-{{ section.id }}.s88-black-friday .quantity-break__price{font-size:24px!important}#quantity-breaks-{{ section.id }} .s88-duration{font-size:8.5px;padding:5px 2px;gap:3px}#quantity-breaks-{{ section.id }} .s88-calendar{flex-basis:12px;width:12px}#quantity-breaks-{{ section.id }}.s88-black-friday .quantity-break__benefit{font-size:9px!important}}
