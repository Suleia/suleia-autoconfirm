{
  "realm": "suleia",
  "enabled": true,
  "displayName": "Suleia Private Operations",
  "registrationAllowed": true,
  "registrationEmailAsUsername": true,
  "rememberMe": false,
  "resetPasswordAllowed": true,
  "verifyEmail": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "bruteForceProtected": true,
  "failureFactor": 5,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "roles": {
    "realm": [
      {
        "name": "mcp_reader",
        "description": "Allows authenticated read-only access to the Suleia MCP"
      },
      {
        "name": "operations_reader",
        "description": "Allows authenticated read-only access to Suleia Operations Center"
      }
    ]
  },
  "clientScopes": [
    {
      "name": "orders:read",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true" }
    },
    {
      "name": "timelines:read",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true" }
    },
    {
      "name": "decisions:read",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true" }
    },
    {
      "name": "reviews:read",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true" }
    },
    {
      "name": "orders:simulate",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true" }
    },
    {
      "name": "operations:read",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true" }
    }
  ],
  "clients": [
    {
      "clientId": "chatgpt-suleia-mcp",
      "name": "ChatGPT Suleia MCP",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": true,
      "consentRequired": true,
      "redirectUris": ["https://chatgpt.com/connector/oauth/*"],
      "webOrigins": ["https://chatgpt.com"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "resource_url": "https://mcp.suleia.com/mcp"
      },
      "defaultClientScopes": [
        "openid",
        "profile",
        "email",
        "roles",
        "orders:read",
        "timelines:read",
        "decisions:read",
        "reviews:read",
        "orders:simulate"
      ],
      "optionalClientScopes": ["offline_access"],
      "protocolMappers": [
        {
          "name": "suleia-realm-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false",
            "usermodel.realmRoleMapping.rolePrefix": ""
          }
        },
        {
          "name": "suleia-mcp-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "chatgpt-suleia-mcp",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "suleia-mcp-url-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "https://mcp.suleia.com/mcp",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "suleia-operations-center",
      "name": "Suleia Operations Center",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": false,
      "consentRequired": false,
      "redirectUris": ["https://ops.suleia.com/*", "https://ops-staging.localhost/*"],
      "webOrigins": ["https://ops.suleia.com", "https://ops-staging.localhost"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "https://ops.suleia.com/*##https://ops-staging.localhost/*"
      },
      "defaultClientScopes": ["openid", "profile", "roles", "operations:read"],
      "protocolMappers": [
        {
          "name": "operations-realm-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false",
            "usermodel.realmRoleMapping.rolePrefix": ""
          }
        },
        {
          "name": "operations-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "suleia-operations-center",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ]
}
