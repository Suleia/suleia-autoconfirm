[Unit]
Description=Telegram campaign command center
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
User=suleiaops
Group=suleiaops
EnvironmentFile=/etc/suleia/telegram.env
Environment=STATE_DIRECTORY=/var/lib/suleia-telegram
WorkingDirectory=/opt/suleia-telegram
ExecStart=/usr/bin/env node /opt/suleia-telegram/service.mjs
Restart=on-failure
RestartSec=15
TimeoutStopSec=90
StateDirectory=suleia-telegram
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
MemoryMax=256M
CPUQuota=50%

[Install]
WantedBy=multi-user.target
