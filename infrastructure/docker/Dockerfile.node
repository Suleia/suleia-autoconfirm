FROM node:22.22.0-alpine AS dependencies
WORKDIR /app/packages/suleia-operations-mcp
COPY packages/suleia-operations-mcp/package.json packages/suleia-operations-mcp/pnpm-lock.yaml ./
RUN corepack enable \
    && corepack prepare pnpm@11.9.0 --activate \
    && pnpm install --prod --frozen-lockfile

FROM node:22.22.0-alpine
ENV NODE_ENV=production
RUN addgroup -S suleia && adduser -S -G suleia suleia
WORKDIR /app
COPY --from=dependencies /app/packages/suleia-operations-mcp/node_modules ./packages/suleia-operations-mcp/node_modules
COPY apps ./apps
COPY services ./services
COPY packages/platform-core ./packages/platform-core
COPY packages/suleia-operations-mcp ./packages/suleia-operations-mcp
USER suleia
