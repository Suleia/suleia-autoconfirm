{
  admin off
  servers {
    timeouts {
      read_body 10s
      read_header 5s
      write 30s
      idle 2m
    }
    max_header_size 32kb
  }
}

(edge_security_headers) {
  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "no-referrer"
    Permissions-Policy "camera=(), microphone=(), geolocation=()"
    -Server
  }
  request_body {
    max_size 64KB
  }
}

{$MCP_PUBLIC_HOST} {
  import edge_security_headers
  header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"

  @dropea_webhooks path /webhooks/dropea/v2/*
  handle @dropea_webhooks {
    request_body {
      max_size 1MB
    }
    reverse_proxy ingestion-worker:3302
  }

  @mcp path /mcp /.well-known/oauth-protected-resource /.well-known/oauth-protected-resource/mcp
  handle @mcp {
    reverse_proxy mcp-server:3100
  }

  @identity path /auth/realms/suleia/* /auth/resources/*
  handle @identity {
    reverse_proxy keycloak:8080
  }

  @operations_api path /operations/api/* /operations/health
  handle @operations_api {
    uri strip_prefix /operations
    reverse_proxy api:3200
  }

  @operations_exact path /operations
  handle @operations_exact {
    redir /operations/ 308
  }

  @operations_ui path /operations/*
  handle @operations_ui {
    uri strip_prefix /operations
    reverse_proxy review-panel:80
  }

  respond 404
}

{$OPS_PUBLIC_HOST} {
  import edge_security_headers
  header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; connect-src 'self' https://mcp.suleia.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self' https://mcp.suleia.com"

  @operations_api path /api/* /health
  handle @operations_api {
    reverse_proxy api:3200
  }

  handle {
    reverse_proxy review-panel:80
  }
}
