[Unit]
Description=Observe persisted address import failures only (no network or writes)

[Service]
Type=oneshot
User=suleiaops
Group=suleiaops
EnvironmentFile=/etc/suleia/address-import-recovery-shadow.env
Environment=ADDRESS_IMPORT_RECOVERY_ENABLED=true
Environment=ADDRESS_RECOVERY_SHOPIFY_WRITE=false
Environment=ADDRESS_RECOVERY_CHATBY_SEND=false
Environment=ADDRESS_RECOVERY_DROPEA_IMPORT=false
Environment=ADDRESS_RECOVERY_STATE_DIR=/var/lib/suleia-address-import-recovery
Environment=ADDRESS_RECOVERY_AUDIT_DIR=/var/lib/suleia-shopify-dropea
Environment=ADDRESS_RECOVERY_PROJECTION_DIR=/var/lib/suleia-address-import-recovery-panel
StateDirectory=suleia-address-import-recovery
StateDirectoryMode=0700
ReadWritePaths=/var/lib/suleia-address-import-recovery-panel
ExecStart=/opt/suleia-node/node-v22.22.0-linux-x64/bin/node /opt/suleia-address-import-recovery/current/services/import-recovery/shadow.mjs
TimeoutStartSec=30
UMask=0077
NoNewPrivileges=true
PrivateNetwork=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/var/lib/suleia-shopify-dropea
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX
Nice=15
IOSchedulingClass=idle
CPUQuota=10%
MemoryMax=128M
TasksMax=64

