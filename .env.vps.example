# Mandatory staging safety envelope
APP_ENV=staging
RUN_MODE=SHADOW_READ_ONLY
SIMULATION_ONLY=true
PRODUCTION_WRITES_ENABLED=false
ACTION_EXECUTOR_ENABLED=false
MCP_WRITE_TOOLS_ENABLED=false
OPENAI_API_ENABLED=false
OPENAI_API_AUTOMATION_ENABLED=false
OPENAI_RESPONSES_API_ENABLED=false
OPENAI_ASSISTANTS_API_ENABLED=false
OPENAI_CHAT_COMPLETIONS_ENABLED=false
EXTERNAL_LLM_CALLS_ENABLED=false
LOCAL_LLM_ENABLED=false
REAL_DATA_WRITE_ENABLED=false
REAL_DATA_READ_ENABLED=true
CONNECTOR_WRITE_ENABLED=false
DROPEA_READ_ENABLED=true
DROPEA_WRITE_ENABLED=false
DROPEA_MUTATION_CLIENT_ENABLED=false
CHATBY_READ_ENABLED=true
CHATBY_WRITE_ENABLED=false
GLS_WRITE_ENABLED=false
INCIDENT_INTERPRETATION_ENABLED=true
INCIDENT_DECISION_ENABLED=true
INCIDENT_SIMULATION_ENABLED=true
ISSUE_RESOLUTION_ENABLED=false
RETURN_EXECUTION_ENABLED=false
ADDRESS_UPDATE_ENABLED=false
CUSTOMER_MESSAGES_ENABLED=false
ORDER_CONFIRMATION_ENABLED=false
ORDER_CANCELLATION_ENABLED=false
RETURN_TO_ORIGIN_ENABLED=false
DISCOUNTS_ENABLED=false
TEMPLATE_SENDING_ENABLED=false
DISCOUNT_SENDING_ENABLED=false
EMAIL_SENDING_ENABLED=false
EXTERNAL_AI_CALLS_ENABLED=false
LIVE_WEBHOOKS_ENABLED=false
LIVE_CRON_ENABLED=false
LIVE_POLLING_ENABLED=false
TEST_PHONE_BLOCK_ENABLED=true
TEST_PHONE_NORMALIZED=
DUPLICATE_ORDER_DETECTION_ENABLED=true
DUPLICATE_ORDER_BLOCKING_ENABLED=false
CHATBY_CONTACT_CLEANUP_PREVIEW_ENABLED=true
CHATBY_CONTACT_DELETE_ENABLED=false
RELEASIT_RETURN_BLOCK_PREVIEW_ENABLED=true
RELEASIT_RETURN_BLOCK_WRITE_ENABLED=false
PII_MASKING_ENABLED=true
AUDIT_LOGGING_ENABLED=true

# Decision thresholds approved for the isolated simulation environment.
DETERMINISTIC_AUTO_ROUTE_CONFIDENCE=0.95
AI_REVIEW_ROUTE_MIN_CONFIDENCE=0.60
HUMAN_REVIEW_REQUIRED_RISK=HIGH
CRITICAL_ALWAYS_BLOCKED=true

# Local-only hostnames. Replace only after VPS authorization.
OPS_STAGING_HOST=ops-staging.localhost
API_STAGING_HOST=api-staging.localhost
MCP_STAGING_HOST=mcp-staging.localhost
MCP_PUBLIC_HOST=mcp.suleia.com

# Generate locally. Never commit populated values.
POSTGRES_DB=suleia_staging
POSTGRES_ADMIN_PASSWORD=change-me
SULEIA_API_PASSWORD=change-me
SULEIA_INGESTION_PASSWORD=change-me
SULEIA_DECISION_ENGINE_PASSWORD=change-me
SULEIA_MCP_READONLY_PASSWORD=change-me
SULEIA_BACKUP_PASSWORD=change-me
MCP_STAGING_BEARER_TOKEN=replace-with-at-least-32-random-characters
SULEIA_KEYCLOAK_DB_PASSWORD=change-me
KEYCLOAK_BOOTSTRAP_ADMIN_PASSWORD=change-me
KEYCLOAK_BOOTSTRAP_ADMIN_CLIENT_SECRET=change-me

MCP_DATA_MODE=fixture
MCP_AUTH_MODE=oauth
MCP_PUBLIC_ENDPOINT_ENABLED=true
MCP_GRANTED_SCOPES=orders:read,timelines:read,decisions:read,reviews:read,platform:read,orders:simulate
MCP_RATE_LIMIT_PER_MINUTE=30
MCP_REQUEST_BODY_LIMIT=64kb
MCP_TOOL_TIMEOUT_MS=10000
MCP_MAX_RESPONSE_BYTES=51200
MCP_RUNTIME_INVENTORY_PATH=/app/private-runtime/platform-runtime.json
MCP_AUDIT_MODE=stderr
READ_ONLY=true

# External connectors deliberately blank and disabled.
SHOPIFY_ACCESS_TOKEN=
DROPEA_ACCESS_TOKEN=
CHATBY_TOKEN=
GLS_TOKEN=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
MIGRATION_HASH_KEY=
SHADOW_PAGE_SIZE=250
SHADOW_POLL_INTERVAL_MS=300000
CHATBY_SUBSCRIBER_CACHE_TTL_MS=900000
CHATBY_READ_MIN_REQUEST_INTERVAL_MS=1500
CHATBY_READ_RETRY_BASE_MS=5000
DROPEA_PUBLIC_API_ENABLED=false
DROPEA_READ_JWT_ES=
DROPEA_STORES_CONFIG=[]
DROPEA_INGESTION_PHASE=CANARY
DROPEA_INGESTION_DRY_RUN=true
DROPEA_PUBLIC_API_RATE_LIMIT=45
DROPEA_PUBLIC_API_MAX_PAGES=200
DROPEA_PUBLIC_API_MAX_RECORDS=20000
DROPEA_WEBHOOK_AUTH_MODE=HMAC_ONLY
DROPEA_WEBHOOK_HMAC_SECRET=
DROPEA_WEBHOOK_PATH_TOKEN_SHA256=

# Retention remains subject to legal and business approval.
BACKUP_DAILY_RETENTION_DAYS=14
BACKUP_WEEKLY_RETENTION_WEEKS=8
BACKUP_MONTHLY_RETENTION_MONTHS=12
BACKUP_RETENTION_STATUS=PENDING_LEGAL_APPROVAL
# Financial control daily refresh. The Meta token must have ads_read only;
# historical tokens with management scope are rejected by the worker.
FINANCE_STORE_ID=
META_ADS_READ_ONLY_ACCESS_TOKEN=
META_ADS_AD_ACCOUNT_ID=
META_ADS_API_VERSION=v25.0
META_ADS_EXPECTED_CURRENCY=EUR
META_ADS_TIMEZONE=Europe/Madrid
